    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Store junction data for all projects
        const junctionDataByProject = {};
        
        // Build the junction data object - WITH UNIQUE KEYS
        {% for project in all_projects %}
            {% if project.junction_boxes %}
                junctionDataByProject[{{ project.id }}] = [
                    {% for jb in project.junction_boxes %}
                        {% if jb.junction_name %}
                            {
                                id: "{{ jb.junction_id }}",
                                name: "{{ jb.junction_name }}",
                                uniqueKey: "{{ jb.junction_id }}|{{ jb.junction_name }}"
                            }{% if not loop.last %},{% endif %}
                        {% endif %}
                    {% endfor %}
                ];
            {% else %}
                junctionDataByProject[{{ project.id }}] = [];
            {% endif %}
        {% endfor %}

        // Create a mapping of unique_key to project_id for quick lookup
        const junctionToProjectMap = {};
        {% for project in all_projects %}
            {% if project.junction_boxes %}
                {% for jb in project.junction_boxes %}
                    {% if jb.junction_name %}
                        junctionToProjectMap["{{ jb.junction_id }}|{{ jb.junction_name }}"] = "{{ project.id }}";
                    {% endif %}
                {% endfor %}
            {% endif %}
        {% endfor %}

        // DOM elements
        const stationFilter = document.getElementById('stationFilter');
        const junctionFilter = document.getElementById('junctionFilter');
        const filterForm = document.getElementById('filterForm');
        const latestOnlyCheckbox = document.getElementById('latestOnlyCheckbox');
        const showWithoutDrawingsCheckbox = document.getElementById('showWithoutDrawingsCheckbox');
        
        // Approval variables
        let pendingPdfId = null;
        let pendingLevel = null;
        let pendingRejectPdfId = null;
        let pendingRejectLevel = null;
        
        // Delete Project variables
        let pendingDeleteProjectId = null;
        let pendingDeleteProjectName = null;
        
        // Function to build pagination URL with all current filters
        function buildPaginationUrl(page, rowsPerPage) {
            const url = new URL(window.location);
            url.searchParams.set('page', page);
            if (rowsPerPage) {
                url.searchParams.set('rows_per_page', rowsPerPage);
            }
            return url.toString();
        }

        // Function to change rows per page
        function changeRowsPerPage(rowsPerPage) {
            const url = buildPaginationUrl(1, rowsPerPage);
            window.location.href = url;
        }

        // Function to update junction filter - Filters based on selected station
        function updateJunctionFilter(selectedStationId) {
            const allJunctionsOption = junctionFilter.querySelector('option[value="all"]');
            junctionFilter.innerHTML = '';
            junctionFilter.appendChild(allJunctionsOption);
       
            // Show junctions based on selected station
            let allJunctions = [];
        
            if (selectedStationId === 'all') {
                // Show ALL junctions from ALL projects
                for (const projectId in junctionDataByProject) {
                    const junctions = junctionDataByProject[projectId] || [];
                    allJunctions = allJunctions.concat(junctions);
                }
            } else {
                // Show only junctions from the selected station
                const junctions = junctionDataByProject[selectedStationId] || [];
                allJunctions = junctions;
            }
        
            // Remove duplicates by unique key (id|name)
            const uniqueJunctions = [];
            const seenKeys = new Set();
        
            allJunctions.forEach(junction => {
                if (!junction || !junction.id || !junction.name || !junction.uniqueKey) {
                    return;
                }
            
                if (!seenKeys.has(junction.uniqueKey)) {
                    seenKeys.add(junction.uniqueKey);
                    uniqueJunctions.push(junction);
                }
            });
        
            // Sort by name
            uniqueJunctions.sort((a, b) => a.name.localeCompare(b.name));
       
            // Populate junction filter
            if (uniqueJunctions.length > 0) {
                uniqueJunctions.forEach(junction => {
                    const option = document.createElement('option');
                    option.value = junction.uniqueKey; // Use unique key
                    option.textContent = `${junction.name}`;
               
                    // Check if this junction was previously selected (full unique match)
                    const currentJunctionId = "{{ current_filters.junction_id|default('') }}";
                    if (currentJunctionId && currentJunctionId === junction.uniqueKey) {
                        option.selected = true;
                    }
               
                    junctionFilter.appendChild(option);
                });
            } else {
                const option = document.createElement('option');
                option.value = '';
                option.textContent = 'No junctions available';
                option.disabled = true;
                junctionFilter.appendChild(option);
            }
        }

        // Function to handle when junction is selected
        function handleJunctionSelection() {
            // No auto-selection of station when junction is selected
        }

        // Function to handle when station is changed
        function handleStationChange() {
            const selectedStationId = stationFilter.value;
            // Update the junction filter to show only junctions from the selected station
            updateJunctionFilter(selectedStationId);
        }
     
        // ENHANCED Notification System
        let notificationCheckInterval;
        let isPollingEnabled = true;
        
        function loadNotifications() {
            if (!isPollingEnabled) return;
          
            fetch('/notifications')
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    updateNotificationUI(data);
                })
                .catch(error => {
                    console.error('Error loading notifications:', error);
                    // Show empty state on error
                    updateNotificationUI({ all_notifications: [], recent_notifications: [] });
                });
        }
        
        function updateNotificationUI(data) {
            const notificationList = document.getElementById('notificationList');
            const notificationCount = document.getElementById('notificationCount');
            const recentList = document.getElementById('recentNotificationsList');
            const unreadCountText = document.getElementById('unreadCountText');

            // Separate all and recent notifications
            const allNotifications = data.all_notifications || [];
            const recentNotifications = data.recent_notifications || [];

            if (!allNotifications || allNotifications.length === 0) {
                // Show empty state for dropdown (All Notifications)
                notificationList.innerHTML = `
                    <div class="notifications-empty">
                        <i class="bi bi-bell-slash fs-4 mb-2"></i>
                        <p class="mb-0">No notifications</p>
                    </div>
                `;
                
                // Show empty state for recent
                recentList.innerHTML = `
                    <div class="text-muted text-center py-4">
                        <i class="bi bi-bell-slash fs-4 mb-2"></i>
                        <p class="mb-0">No recent notifications</p>
                    </div>
                `;
                notificationCount.textContent = '0';
                notificationCount.style.display = 'none';
                unreadCountText.textContent = '';
                return;
            }

            // Filter unread notifications from ALL notifications
            const unreadNotifications = allNotifications.filter(n => !n.is_read);
            const unreadCount = unreadNotifications.length;

            // Update badge count and text
            notificationCount.textContent = unreadCount;
            notificationCount.style.display = unreadCount > 0 ? 'block' : 'none';

            // Update header text
            if (unreadCount > 0) {
                unreadCountText.textContent = `(${unreadCount} unread)`;
                unreadCountText.style.color = '#ffcc00';
            } else {
                unreadCountText.textContent = '(all read)';
                unreadCountText.style.color = '#28a745';
            }

            // Add pulse animation to bell if there are unread notifications
            const bellButton = document.querySelector('#notificationDropdown');
            if (unreadCount > 0) {
                bellButton.classList.add('pulse');
            } else {
                bellButton.classList.remove('pulse');
            }

            // Update dropdown notification list (ALL notifications)
            let dropdownHtml = '';
            allNotifications.forEach(notification => {
                const statusClass = notification.status === 'approved' ? 'success' :
                                 notification.status === 'rejected' ? 'danger' :
                                 notification.status === 'pending' ? 'warning' : 'secondary';

                const levelBadge = notification.level === 'level1' ? 'bg-info' :
                                 notification.level === 'level2' ? 'bg-warning' :
                                 notification.level === 'level3' ? 'bg-danger' : 'bg-secondary';

                dropdownHtml += `
                    <div class="notification-item ${!notification.is_read ? 'unread' : 'read'}" data-id="${notification.id}" onclick="viewNotification(${notification.id})">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center mb-1">
                                    <span class="badge ${levelBadge} me-2">${notification.level.toUpperCase()}</span>
                                    <span class="badge bg-${statusClass}">${notification.status.toUpperCase()}</span>
                                </div>
                                <div class="mb-1">
                                    <strong class="${notification.is_read ? 'notification-title' : 'text-dark'}">${notification.project_name}</strong>
                                </div>
                                <div class="small ${notification.is_read ? 'notification-message' : 'text-muted'} mb-2">
                                    ${notification.message}
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="time">
                                        <i class="bi bi-clock"></i> ${notification.created_at}
                                    </small>
                                    <div class="actions">
                                        ${!notification.is_read ? `
                                        <button class="btn btn-sm mark-read-btn" onclick="markNotificationRead(${notification.id}, event)" title="Mark as read">
                                            <i class="bi bi-check"></i>
                                        </button>
                                        ` : ''}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });

            notificationList.innerHTML = dropdownHtml;

            // Update recent notifications list (only non-dismissed)
            let recentHtml = '';
            if (recentNotifications.length > 0) {
                recentNotifications.forEach(notification => {
                    const statusClass = notification.status === 'approved' ? 'success' :
                                     notification.status === 'rejected' ? 'danger' :
                                     notification.status === 'pending' ? 'warning' : 'secondary';

                    const levelBadge = notification.level === 'level1' ? 'bg-info' :
                                     notification.level === 'level2' ? 'bg-warning' :
                                     notification.level === 'level3' ? 'bg-danger' : 'bg-secondary';

                    recentHtml += `
                        <div class="recent-notification-item ${!notification.is_read ? 'unread' : 'read'}" data-id="${notification.id}" onclick="viewNotification(${notification.id})">
                            <div class="d-flex align-items-start w-100">
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="badge ${levelBadge} me-2">${notification.level.toUpperCase()}</span>
                                        <span class="badge bg-${statusClass}">${notification.status.toUpperCase()}</span>
                                    </div>
                                    <div class="mb-1">
                                        <strong class="${notification.is_read ? 'notification-title' : 'text-dark'}">${notification.project_name}</strong>
                                    </div>
                                    <div class="small ${notification.is_read ? 'notification-message' : 'text-muted'} mb-1">
                                        ${notification.message}
                                    </div>
                                    <small class="time">
                                        <i class="bi bi-clock me-1"></i>${notification.created_at}
                                    </small>
                                </div>
                                <button class="btn-close btn-close-sm ms-2" onclick="dismissNotification(event, ${notification.id})" title="Dismiss notification" aria-label="Dismiss"></button>
                            </div>
                        </div>
                    `;
                });
            } else {
                recentHtml = `
                    <div class="text-muted text-center py-4">
                        <i class="bi bi-bell-slash fs-4 mb-2"></i>
                        <p class="mb-0">No recent notifications</p>
                    </div>
                `;
            }

            recentList.innerHTML = recentHtml;
        }
        
        function viewNotification(notificationId) {
            // Navigate to the relevant page or show details
            // For now, just mark as read when clicked
            markNotificationRead(notificationId);
        }
        
        function markNotificationRead(notificationId, event = null) {
            if (event) {
                event.stopPropagation();
            }
          
            fetch(`/mark_notification_read/${notificationId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update the specific notification in the UI without reloading
                    const notificationItem = document.querySelector(`.notification-item[data-id="${notificationId}"]`);
                    const recentItem = document.querySelector(`.recent-notification-item[data-id="${notificationId}"]`);
                  
                    if (notificationItem) {
                        notificationItem.classList.remove('unread');
                        notificationItem.classList.add('read');
                        notificationItem.removeAttribute('onclick');
                        notificationItem.style.cursor = 'default';
                      
                        // Update text colors
                        const title = notificationItem.querySelector('strong');
                        if (title) {
                            title.classList.remove('text-dark');
                            title.classList.add('notification-title');
                        }
                      
                        const message = notificationItem.querySelector('.small');
                        if (message) {
                            message.classList.remove('text-muted');
                            message.classList.add('notification-message');
                        }
                      
                        // Hide the mark as read button
                        const actionBtn = notificationItem.querySelector('.actions');
                        if (actionBtn) actionBtn.innerHTML = '';
                      
                        // Update time styling
                        const time = notificationItem.querySelector('.time');
                        if (time) {
                            time.style.color = '#6c757d';
                            time.style.fontWeight = '400';
                            time.style.background = 'none';
                            time.style.padding = '0';
                        }
                    }
                  
                    if (recentItem) {
                        recentItem.classList.remove('unread');
                        recentItem.classList.add('read');
                        recentItem.removeAttribute('onclick');
                        recentItem.style.cursor = 'default';
                      
                        const title = recentItem.querySelector('strong');
                        if (title) {
                            title.classList.remove('text-dark');
                            title.classList.add('notification-title');
                        }
                      
                        const message = recentItem.querySelector('.small');
                        if (message) {
                            message.classList.remove('text-muted');
                            message.classList.add('notification-message');
                        }
                      
                        // Update time styling
                        const time = recentItem.querySelector('.time');
                        if (time) {
                            time.style.color = '#6c757d';
                            time.style.fontWeight = '400';
                        }
                    }
                  
                    // Update the notification count
                    const notificationCount = document.getElementById('notificationCount');
                    let currentCount = parseInt(notificationCount.textContent) || 0;
                    if (currentCount > 0) {
                        currentCount--;
                        notificationCount.textContent = currentCount;
                        if (currentCount === 0) {
                            notificationCount.style.display = 'none';
                            document.querySelector('#notificationDropdown').classList.remove('pulse');
                        }
                    }
                  
                    // Update header text
                    const unreadCountText = document.getElementById('unreadCountText');
                    const newCount = currentCount;
                    if (newCount > 0) {
                        unreadCountText.textContent = `(${newCount} unread)`;
                        unreadCountText.style.color = '#ffcc00';
                    } else {
                        unreadCountText.textContent = '(all read)';
                        unreadCountText.style.color = '#28a745';
                    }
                }
            })
            .catch(error => {
                console.error('Error marking notification as read:', error);
                alert('Failed to mark notification as read. Please try again.');
            });
        }
        
        function dismissNotification(event, notificationId) {
            event.stopPropagation();
            
            fetch(`/dismiss_notification/${notificationId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Remove the notification from recent list
                    const item = event.target.closest('.recent-notification-item');
                    if (item) {
                        item.remove();
                        // Check if recent list is now empty
                        const recentList = document.getElementById('recentNotificationsList');
                        const remainingItems = recentList.querySelectorAll('.recent-notification-item');
                        if (remainingItems.length === 0) {
                            recentList.innerHTML = `
                                <div class="text-muted text-center py-4">
                                    <i class="bi bi-bell-slash fs-4 mb-2"></i>
                                    <p class="mb-0">No recent notifications</p>
                                </div>
                            `;
                        }
                    }
                } else {
                    alert('Failed to dismiss notification');
                }
            })
            .catch(error => {
                console.error('Error dismissing notification:', error);
                alert('Error dismissing notification');
            });
        }
        
        function markAllNotificationsRead() {
            // First, update the UI immediately for better UX
            const notificationItems = document.querySelectorAll('.notification-item.unread');
            const recentItems = document.querySelectorAll('.recent-notification-item.unread');
          
            // Update all unread notifications to read style
            notificationItems.forEach(item => {
                item.classList.remove('unread');
                item.classList.add('read');
                item.removeAttribute('onclick');
                item.style.cursor = 'default';
              
                // Update text colors
                const title = item.querySelector('strong');
                if (title) {
                    title.classList.remove('text-dark');
                    title.classList.add('notification-title');
                }
              
                const message = item.querySelector('.small');
                if (message) {
                    message.classList.remove('text-muted');
                    message.classList.add('notification-message');
                }
              
                // Hide the mark as read button
                const actionBtn = item.querySelector('.actions');
                if (actionBtn) actionBtn.innerHTML = '';
              
                // Update time styling
                const time = item.querySelector('.time');
                if (time) {
                    time.style.color = '#6c757d';
                    time.style.fontWeight = '400';
                    time.style.background = 'none';
                    time.style.padding = '0';
                }
            });
          
            recentItems.forEach(item => {
                item.classList.remove('unread');
                item.classList.add('read');
                item.removeAttribute('onclick');
                item.style.cursor = 'default';
              
                const title = item.querySelector('strong');
                if (title) {
                    title.classList.remove('text-dark');
                    title.classList.add('notification-title');
                }
              
                const message = item.querySelector('.small');
                if (message) {
                    message.classList.remove('text-muted');
                    message.classList.add('notification-message');
                }
              
                // Update time styling
                const time = item.querySelector('.time');
                if (time) {
                    time.style.color = '#6c757d';
                    time.style.fontWeight = '400';
                }
            });
          
            // Update the notification count
            const notificationCount = document.getElementById('notificationCount');
            notificationCount.textContent = '0';
            notificationCount.style.display = 'none';
          
            // Remove pulse animation
            document.querySelector('#notificationDropdown').classList.remove('pulse');
          
            // Update header text
            const unreadCountText = document.getElementById('unreadCountText');
            unreadCountText.textContent = '(all read)';
            unreadCountText.style.color = '#28a745';
          
            // Then send the request to the server
            fetch('/mark_all_notifications_read', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    console.log('All notifications marked as read');
                }
            })
            .catch(error => {
                console.error('Error marking all notifications as read:', error);
                // On error, reload notifications to sync with server
                loadNotifications();
            });
        }
        
