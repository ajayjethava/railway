                })
                .catch(error => {
                    console.error('Error loading approval history:', error);
                    timeline.innerHTML = `
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            Error loading approval history
                        </div>
