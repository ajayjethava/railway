            const level1Status = document.getElementById('historyLevel1Status');
            const level1Approver = document.getElementById('historyLevel1Approver');
            const level1Date = document.getElementById('historyLevel1Date');
            
            level1Status.textContent = status.level1.status.toUpperCase();
            level1Status.className = `badge bg-${status.level1.status === 'approved' ? 'success' : 
                                    status.level1.status === 'rejected' ? 'danger' : 'secondary'}`;
            level1Approver.textContent = status.level1.approver || 'Pending';
            level1Date.textContent = status.level1.date || '-';
            
            // Update Level 2 status
            const level2Status = document.getElementById('historyLevel2Status');
            const level2Approver = document.getElementById('historyLevel2Approver');
            const level2Date = document.getElementById('historyLevel2Date');
            
            level2Status.textContent = status.level2.status.toUpperCase();
            level2Status.className = `badge bg-${status.level2.status === 'approved' ? 'success' : 
                                    status.level2.status === 'rejected' ? 'danger' : 'secondary'}`;
            level2Approver.textContent = status.level2.approver || 'Pending';
            level2Date.textContent = status.level2.date || '-';
            
            // Update Level 3 status
            const level3Status = document.getElementById('historyLevel3Status');
            const level3Approver = document.getElementById('historyLevel3Approver');
            const level3Date = document.getElementById('historyLevel3Date');
            
            level3Status.textContent = status.level3.status.toUpperCase();
            level3Status.className = `badge bg-${status.level3.status === 'approved' ? 'success' : 
                                    status.level3.status === 'rejected' ? 'danger' : 'secondary'}`;
            level3Approver.textContent = status.level3.approver || 'Pending';
            level3Date.textContent = status.level3.date || '-';
        }
        
        function buildTimeline(history) {
            const timeline = document.getElementById('approvalTimeline');
            
            if (history.length === 0) {
                timeline.innerHTML = `
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        No approval history available yet
                    </div>
                `;
                return;
            }
            
            let timelineHTML = '';
            
            history.forEach(item => {
                const statusClass = item.status === 'approved' ? 'approved' : 
                                  item.status === 'rejected' ? 'rejected' : 'pending';
                
                timelineHTML += `
                    <div class="timeline-item ${statusClass}">
                        <div class="timeline-content">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge bg-${item.status === 'approved' ? 'success' : 'danger'} me-2">
                                        Level ${item.level}
                                    </span>
                                    <span class="badge bg-${item.status === 'approved' ? 'success' : 'danger'}">
                                        ${item.status.toUpperCase()}
                                    </span>
                                </div>
                                <small class="text-muted">${item.time_ago}</small>
                            </div>
                            <div class="mb-2">
                                <strong>${item.approver.username}</strong>
                                <small class="text-muted ms-2">(${item.approver.designation})</small>
                            </div>
                            <div class="timeline-date">
                                <i class="bi bi-calendar me-1"></i>${item.created_at}
                            </div>
                            ${item.remarks ? `
                            <div class="timeline-remarks">
                                <strong>Remarks:</strong>
                                <p class="mb-0 mt-1">${item.remarks}</p>
                            </div>
                            ` : ''}
                        </div>
                    </div>
                `;
            });
            
            timeline.innerHTML = timelineHTML;
        }
        
